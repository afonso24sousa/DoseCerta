<?xml version="1.0" encoding="utf-8"?>
<!-- Cobertura do backend (Regulamento Interno do Grupo, secção 11.5 / QG-04):
     inclui todo o código do backend; exclui Migrations/ e Program.cs, e o código gerado pelo compilador. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[DoseCerta.Api]*</Include>
          <ExcludeByFile>**/Migrations/*.cs,**/Program.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
