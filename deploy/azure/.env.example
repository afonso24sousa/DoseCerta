# Modelo do ficheiro deploy/azure/.env da VM (nunca versionar).
# Na demonstração, o .env é escrito pelo workflow backend-cd a partir dos GitHub Secrets do environment "demonstracao".
# Palavras-passe e chave JWT só com letras e algarismos: um ' parte o T-SQL e um $ é interpretado pelo Docker Compose.
# Regras do SQL Server: pelo menos 8 carateres e 3 destes 4 tipos: maiúsculas, minúsculas, algarismos, símbolos.
DOMINIO=dosecerta.spaincentral.cloudapp.azure.com
# Edição do SQL Server; vazio ou ausente = Developer (Regulamento Interno do Grupo, secção 11.2).
MSSQL_PID=Developer
# Só tem efeito na primeira criação do volume sql-dados; escolher o valor definitivo antes da primeira publicação.
MSSQL_SA_PASSWORD=<palavra-passe-forte-do-sa>
DOSECERTA_APP_PASSWORD=<palavra-passe-forte-do-utilizador-da-api>
JWT_CHAVE=<segredo-com-pelo-menos-32-carateres>
# SMTP opcional: vazio = a API não envia e-mails.
EMAIL_SERVIDOR=
EMAIL_PORTA=587
EMAIL_UTILIZADOR=
EMAIL_PALAVRA_PASSE=
EMAIL_REMETENTE=
